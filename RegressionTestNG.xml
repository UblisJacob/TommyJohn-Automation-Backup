<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Regression Test Suite" thread-count="3">

	<listeners>
		<listener class-name="TestScenario.ListenerClass"></listener>
	</listeners>

	<test name="MegaCollectionTests">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="TestModules.ValidateCategoryPages" />
		</classes>
	</test>

	<test name="AllQuizTests">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="TestModules.ValidateQuiz" />
		</classes>
	</test>

	<test name="CreateAccountAndLoginTests">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="TestModules.ValidateCreateAccount_Login" />
		</classes>
	</test>


	<test thread-count="1" name="ProductPageTests" verbose="1" parallel="tests">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="TestModules.ValidatePDP" />
		</classes>
	</test>

