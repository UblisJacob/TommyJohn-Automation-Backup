<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Image Test Suite" thread-count="3">

    <listeners>
        <listener class-name="TestScenario.ImageListenerClass"></listener>
        <listener class-name="TestScenario.RetryListener"></listener>
    </listeners>

    <test name="ImageTest">
        <parameter name="browser" value="chrome" />
        <classes>
            <class name= "TestModules.ValidatePDP"/>
        </classes>
    </test>
</suite>
