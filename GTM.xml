<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="GTM Test Suite" thread-count="3">

	<listeners>
		<listener class-name="TestScenario.GTMListenerClass"></listener>
		<listener class-name="TestScenario.RetryListener"></listener>
	</listeners>

	<test name="GTMTests">
		<parameter name="browser" value="firefox" />
		<classes>
			<class name="TestModules.ValidateGTM" />
		</classes>	
	</test>
</suite>