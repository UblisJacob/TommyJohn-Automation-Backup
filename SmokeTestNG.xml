			<class name="TestScenario.ValidateMegaCollectionPages">
				<methods>
					<include
						name="TC_ValidateProductImageOnAllPantiesInWomenCategory" />
					<include
						name="TC_ValidateProductNameOnAllUnderwearInMenCategory" />
					<include
						name="TC_ValidateProductReviewStarsOnAllUndershirtsInMenCategory" />
					<include
						name="TC_ValidateFiltersAndSortingOnAllWomensCollectioninWomenCategory" />
					<include
						name="TC_ValidateStyleCarouselOnAllUnderwearInMenCategory" />
					<include name="TC_ValidateColorSwatchOnAllUndershirts" />

				</methods>

			</class>

		</classes>
	</test>

	<test thread-count="1" name="ProductPageTests" verbose="1"
		parallel="tests">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="TestScenario.ValidateProductDetailsPage">
				<methods>
					<include name="TC_verifyProductDetailsPage" />
					<include name="TC_verifyReviewsSectionOnPDP" />
					<include name="TC_VerifyJoinTheWaitlistFunctionality" />
					<include name="TC_VerifyRecommendedForYouSection" />
				</methods>

			</class>
		</classes>
	</test>

